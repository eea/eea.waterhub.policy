<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="eea.waterhub.policy"
    >

  <genericsetup:registerProfile
      name="default"
      title="WaterHub Policy"
      description="Configure a Plone site for the Copernicus Thematic Water Hub."
      directory="profiles/default"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      post_handler=".setuphandlers.post_install"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="WaterHub Policy: uninstall"
      description="Remove configuration installed by the WaterHub policy."
      directory="profiles/uninstall"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      post_handler=".setuphandlers.uninstall"
      />

  <genericsetup:upgradeStep
      title="Install the EEA Volto policy"
      description="Install the backend support required by the EEA Design System."
      source="1000"
      destination="1001"
      handler=".upgrades.install_eea_volto_policy"
      profile="eea.waterhub.policy:default"
      />

  <genericsetup:upgradeStep
