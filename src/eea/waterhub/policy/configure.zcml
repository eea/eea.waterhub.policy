<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="eea.waterhub.policy"
    >

  <include package="collective.volto.formsupport" />

  <include file="profiles.zcml" />

  <browser:page
      name="friendly-captcha-controlpanel"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      class=".controlpanel.FriendlyCaptchaControlPanelView"
      permission="cmf.ManagePortal"
      layer=".interfaces.IWaterHubPolicyLayer"
      />

  <adapter
      factory=".controlpanel.FriendlyCaptchaConfigletPanel"
      provides=".controlpanel.IFriendlyCaptchaControlPanel"
      name="friendly-captcha"
      />

  <adapter
      factory=".captcha.FriendlyCaptchaSupport"
      provides="collective.volto.formsupport.interfaces.ICaptchaSupport"
      for="*
           zope.publisher.interfaces.browser.IBrowserRequest"
      name="friendly_captcha"
      />

</configure>
